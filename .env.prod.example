# Production / public-demo configuration.
#
#   cp .env.prod.example .env.prod    then fill in every value
#
# .env.prod is gitignored. Nothing in it may be committed.
# Generate each secret separately:
#
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#
# Every variable below without a default is required — compose refuses
# to start and names the missing one rather than falling back to
# something guessable.

# ---------------------------------------------------------------
# HOST
# ---------------------------------------------------------------
# The domain whose A record points at this machine. Caddy obtains a
# certificate for exactly this name.
#
# CHANGING THIS REQUIRES A FRONTEND REBUILD. Vite bakes the API URL
# into the bundle, so a plain `up -d` keeps serving one that talks to
# the old host:
#   docker compose -f docker-compose.prod.yml --env-file .env.prod build --no-cache web
DOMAIN=demo.example.com

# Required, and it must not be blank. Let's Encrypt uses it to warn
# you before a renewal failure becomes an expired certificate — and an
# empty value is a Caddyfile parse error, not a default.
ACME_EMAIL=you@example.com

# ---------------------------------------------------------------
# SECRETS
# ---------------------------------------------------------------
# Superuser password. Used by migrations only.
POSTGRES_PASSWORD=

# Password for citadel_app, the least-privilege role the API and the
# wipe job connect as.
#
# Read ONCE, at database initialisation. Changing it later does not
# change the role — see DEPLOY.md for the ALTER ROLE.
APP_DB_PASSWORD=

# Signs access tokens. Minimum 32 characters; the server refuses to
# start below that rather than issuing weakly signed tokens.
JWT_SECRET=

# ---------------------------------------------------------------
# DEMO ACCOUNT
# ---------------------------------------------------------------
# NOT A SECRET. This password is printed on the unlock screen and
# inlined into the public JavaScript bundle, deliberately — it is how
# a reviewer gets in. Never reuse a real password here.
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=demo-vault-2026

# Hour (UTC) of the nightly wipe and reseed. The banner tells visitors
# 03:00, so change both together.
WIPE_HOUR_UTC=3

# ---------------------------------------------------------------
# RATE LIMITS  (optional — these are the production defaults)
# ---------------------------------------------------------------
# Per IP, per 15 minutes. Auth endpoints are tighter because each one
# costs a 64 MiB Argon2 verification, which is the real capacity
# limit on a 2 GB box.
# AUTH_RATE_LIMIT_MAX=6
# API_RATE_LIMIT_MAX=200

# Account creation, on its own counter since the signup bucket was
# split out of the auth one. Measured in ACCOUNTS, not requests:
# signup costs exactly one request from this bucket, so the number is
# the number of vaults one address may create per window. The default
# is 20.
#
# SETTING THIS HERE DOES NOTHING TODAY. docker-compose.prod.yml passes
# environment to the API through an explicit `environment:` map and
# declares no `env_file:`, so a variable that map does not name never
# reaches the container — Compose interpolates it and then drops it.
# Making this line take effect requires adding
#
#     SIGNUP_RATE_LIMIT_MAX: ${SIGNUP_RATE_LIMIT_MAX:-20}
#
# to the server service in docker-compose.prod.yml. Until then the
# code default of 20 is what production runs. After adding it, check
# that `docker compose up -d` reports the server container as
# Recreated; Running means the environment did not change and the
# value did not take.
# SIGNUP_RATE_LIMIT_MAX=20
