# Copy to .env and fill in. .env is gitignored — never commit real values.
#
# Generate a secret:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

POSTGRES_PASSWORD=change-me
JWT_SECRET=change-me-to-at-least-32-characters

# Override if these ports are already taken. If you change SERVER_PORT
# you must also rebuild the web image — Vite bakes the API URL into
# the bundle at build time, so `docker compose up --build` is required.
# SERVER_PORT=3000
# WEB_PORT=8080